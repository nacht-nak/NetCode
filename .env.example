# Optional: the real contact email and public social profile URLs.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=
VITE_GITHUB_URL=
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
VITE_LINKEDIN_URL=

# The included backend. Leave this as /api/contact for a single-server deployment.
VITE_CONTACT_ENDPOINT=/api/contact

# Private server settings. NEVER prefix credentials with VITE_.
# Enable Google 2-Step Verification and create an App Password (not your login password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: defaults to GMAIL_USER. Only this configured address receives inquiries.
CONTACT_TO_EMAIL=

# Production Node server port (npm run start:prod).
PORT=3000
# Public website origin, e.g. https://www.example.com (no trailing slash).
# Set this when hosting behind HTTPS termination or using a separate frontend host.
CONTACT_ALLOWED_ORIGIN=
# Optional: comma-separated trusted proxy IPs/subnets from your hosting provider.
# Leave empty for direct access; e.g. loopback for a local reverse proxy.
TRUST_PROXY=
